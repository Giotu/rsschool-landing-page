{
  "name": "rsschool-landing-page",
  "version": "1.0.0",
  "description": "Responsive two-page landing page built as part of the Rolling Scopes School Fullstack Engineering course.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:css": "stylelint src/css/**/*.css",
    "check": "npm run lint && npm run lint:css && npm run format:check",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Giotu/rsschool-landing-page.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Giotu/rsschool-landing-page/issues"
  },
  "homepage": "https://github.com/Giotu/rsschool-landing-page#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.css": "stylelint --fix",
    "*.{js,css,html}": "prettier --write"
  }
}
